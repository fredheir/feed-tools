#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

if [[ -n "${REPO_STANDARDS_LOCAL:-}" ]]; then
  exec pnpm --dir "$REPO_STANDARDS_LOCAL" --silent --filter @markolo-research/repo-standards repo-standards doctor --root "$ROOT_DIR" --config repo-standards.config.json "$@"
fi

exec pnpm exec repo-standards doctor --config repo-standards.config.json "$@"
