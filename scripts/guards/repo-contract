#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

mode="full"
if [ "${1:-}" = "--staged" ]; then
  mode="staged"
fi

failures=()

fail() {
  failures+=("$1")
}

require_file() {
  [ -f "$1" ] || fail "missing required file: $1"
}

require_symlink_target() {
  local path="$1"
  local target="$2"

  if [ ! -L "$path" ]; then
    fail "missing required symlink: $path -> $target"
    return
  fi

  local actual
  actual="$(readlink "$path")"
  [ "$actual" = "$target" ] || fail "wrong symlink target: $path -> $actual, expected $target"
}

require_file AGENTS.md
require_symlink_target CLAUDE.md AGENTS.md
require_file justfile
require_file lefthook.yml
require_file package.json
require_file pnpm-lock.yaml
require_file pnpm-workspace.yaml
require_file .env.example
require_file .github/workflows/actions-hygiene.yml
require_file .github/workflows/contract.yml
require_file .github/workflows/dependency.yml
require_file .github/workflows/format.yml
require_file .github/workflows/secrets.yml
require_file .github/workflows/typecheck.yml
require_file .github/actionlint.yaml

if fdfind '^lefthook\.yml$' . | grep -v '^./lefthook.yml$' >/dev/null; then
  fail "nested lefthook.yml files are forbidden"
fi

if [ -d .husky ]; then
  fail ".husky is legacy; use root lefthook.yml"
fi

if [ -f .pre-commit-config.yaml ]; then
  fail ".pre-commit-config.yaml is legacy; use root lefthook.yml"
fi

mapfile -t npm_lockfiles < <(fdfind '^(package-lock\.json|yarn\.lock)$' . -t f)
for path in "${npm_lockfiles[@]}"; do
  fail "npm/yarn lockfiles are forbidden in pnpm-managed repos: $path"
done

if ! jq -e '.packageManager | test("^pnpm@10\\.")' package.json >/dev/null; then
  fail "package.json must pin packageManager to pnpm@10.x"
fi

if ! yq -e '.minimumReleaseAge == 10080' pnpm-workspace.yaml >/dev/null; then
  fail "pnpm-workspace.yaml must set minimumReleaseAge: 10080"
fi

if jq -e '.scripts.prepare? // "" | test("husky|prek")' package.json >/dev/null; then
  fail "package.json prepare script must not install legacy hooks"
fi

if jq -e '(.devDependencies // {}) | has("husky") or has("@j178/prek")' package.json >/dev/null; then
  fail "husky and prek are legacy hook dependencies; use lefthook.yml"
fi

mapfile -t workflows < <(fdfind -e yml -e yaml . .github/workflows -t f | sort)
if [ "${#workflows[@]}" -eq 0 ]; then
  fail "missing GitHub Actions workflows under .github/workflows"
fi

for workflow in "${workflows[@]}"; do
  if yq -e 'has("pull_request_target")' "$workflow" >/dev/null; then
    fail "$workflow must not use pull_request_target"
  fi

  permissions_contents="$(yq -r '.permissions.contents // ""' "$workflow")"
  if [ "$permissions_contents" != "read" ]; then
    fail "$workflow must declare top-level permissions.contents: read"
  fi

  mapfile -t checkout_credentials < <(
    yq -r '.jobs[]?.steps[]? | select((.uses? // "") | test("^actions/checkout@")) | (.["with"]["persist-credentials"] | tostring)' "$workflow"
  )
  for persist_credentials in "${checkout_credentials[@]}"; do
    if [ "$persist_credentials" != "false" ]; then
      fail "$workflow checkout steps must set persist-credentials: false"
    fi
  done

  mapfile -t action_refs < <(yq -r '.jobs[]?.steps[]?.uses? // empty' "$workflow")
  for action_ref in "${action_refs[@]}"; do
    if [[ ! "$action_ref" =~ @[0-9a-f]{40}$ ]]; then
      fail "$workflow action ref must be pinned to a full commit SHA: $action_ref"
    fi
  done
done

if ! yq -e '.jobs[]?.steps[]? | select(.run? == "actionlint")' .github/workflows/actions-hygiene.yml >/dev/null; then
  fail ".github/workflows/actions-hygiene.yml must run actionlint"
fi

if ! yq -e '.jobs[]?.steps[]? | select((.run? // "") | test("(^| )zizmor( |$)"))' .github/workflows/actions-hygiene.yml >/dev/null; then
  fail ".github/workflows/actions-hygiene.yml must run zizmor"
fi

if [ "$mode" = "full" ]; then
  if [ ! -d node_modules ]; then
    fail "node_modules is missing; run: just sync"
  fi
fi

if [ "${#failures[@]}" -gt 0 ]; then
  printf 'Repo contract failed:\n' >&2
  printf '  - %s\n' "${failures[@]}" >&2
  exit 1
fi

echo "Repo contract OK."
