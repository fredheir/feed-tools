#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

git ls-files -z --cached --others --exclude-standard |
  while IFS= read -r -d '' path; do
    [ -e "$path" ] && printf '%s\0' "$path"
  done |
  rsync -a --files-from=- --from0 ./ "$tmp/"

gitleaks detect --source "$tmp" --no-git --redact
