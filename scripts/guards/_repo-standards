#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

run_local() {
  local package_root="$1"
  shift
  local cli="$package_root/packages/repo-standards/dist/cli.js"

  if [[ ! -f "$cli" ]]; then
    echo "repo-standards CLI not found at $cli" >&2
    exit 1
  fi

  exec node "$cli" "$@" --root "$ROOT_DIR" --config repo-standards.config.json
}

standards_root="${REPO_STANDARDS_LOCAL:-$ROOT_DIR/../markolo-shared}"
run_local "$standards_root" "$@"
