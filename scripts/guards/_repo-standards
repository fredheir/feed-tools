#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

cli="$ROOT_DIR/scripts/vendor/repo-standards-cli.cjs"
if [[ ! -f "$cli" ]]; then
  echo "repo-standards CLI not found at $cli" >&2
  exit 1
fi

exec node "$cli" "$@" --root "$ROOT_DIR" --config repo-standards.config.json
