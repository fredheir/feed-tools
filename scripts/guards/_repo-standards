#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT_DIR"

standards_root="${REPO_STANDARDS_LOCAL:-}"
if [[ -z "$standards_root" && -f "$HOME/Projects/markolo-shared/packages/repo-standards/dist/cli.js" ]]; then
  standards_root="$HOME/Projects/markolo-shared"
fi
if [[ -z "$standards_root" && -f "$ROOT_DIR/../markolo-shared/packages/repo-standards/dist/cli.js" ]]; then
  standards_root="$ROOT_DIR/../markolo-shared"
fi

if [[ -n "$standards_root" ]]; then
  cli="$standards_root/packages/repo-standards/dist/cli.js"
  if [[ ! -f "$cli" ]]; then
    echo "repo-standards CLI not found at $cli" >&2
    exit 1
  fi
  exec node "$cli" "$@" --root "$ROOT_DIR" --config repo-standards.config.json
fi

if command -v repo-standards >/dev/null 2>&1; then
  exec repo-standards "$@" --root "$ROOT_DIR" --config repo-standards.config.json
fi

case "${1:-}" in
sync-if-needed)
  cat >&2 <<'MSG'
repo-standards is unavailable; skipping maintainer-only sync-if-needed.
Normal consumers can run pnpm install and the feed-* commands without markolo-shared access.
MSG
  exit 0
  ;;
doctor)
  cat >&2 <<'MSG'
repo-standards is unavailable; skipping maintainer-only repo contract check.
Normal consumers can run pnpm install, feed-* commands, lint, typecheck, and tests without markolo-shared access.
MSG
  exit 0
  ;;
secrets | secrets-staged)
  cat >&2 <<'MSG'
repo-standards is unavailable; skipping maintainer-only secret pattern check.
Normal consumers can run pnpm install, feed-* commands, lint, typecheck, and tests without markolo-shared access.
MSG
  exit 0
  ;;
esac

cat >&2 <<'MSG'
repo-standards is maintainer-only tooling and is not required for normal feed-tools use.

To run this guard, set REPO_STANDARDS_LOCAL to a markolo-shared checkout or install a repo-standards binary on PATH.
Normal consumers can run pnpm install and the feed-* commands without markolo-shared access.
MSG
exit 1
