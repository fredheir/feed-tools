#!/usr/bin/env bash
set -euo pipefail

JUST_VERSION="${JUST_VERSION:-1.43.0}"
RG_VERSION="${RG_VERSION:-14.1.1}"

bin_dir="${RUNNER_TEMP:-/tmp}/ci-bin"
mkdir -p "$bin_dir"

if ! command -v rg >/dev/null 2>&1; then
  rg_bin="$bin_dir/rg"
  if [ ! -x "$rg_bin" ]; then
    archive="ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz"
    curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/${archive}" \
      | tar -xz -C "$bin_dir" --strip-components=1 "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg"
  fi
fi

export PATH="$bin_dir:$PATH"
if [ -n "${GITHUB_PATH:-}" ]; then
  echo "$bin_dir" >> "$GITHUB_PATH"
fi

if command -v just >/dev/null 2>&1; then
  exec just "$@"
fi

just_bin="$bin_dir/just"
if [ ! -x "$just_bin" ]; then
  archive="just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz"
  curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/${archive}" \
    | tar -xz -C "$bin_dir" just
fi

exec "$just_bin" "$@"
