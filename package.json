{
  "name": "@markolo/feed-tools",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "pnpm run typecheck && eslint .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=ExperimentalWarning\" vitest run",
    "doctor": "./bin/feed-doctor",
    "mcp": "node ./bin/feed-mcp",
    "setup:sandbox": "./bin/feed-setup-sandbox",
    "deadcode": "knip",
    "slop:scan": "slop-scan scan .",
    "slop:lint": "slop-scan scan . --lint",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test && pnpm run deadcode",
    "setup:yt-dlp": "uv tool install --force 'yt-dlp[default,curl-cffi]'",
    "setup:ffmpeg": "./bin/feed-setup-ffmpeg"
  },
  "knip": {
    "entry": [
      "bin/feed-capture",
      "bin/feed-capture-cic",
      "bin/feed-classify",
      "bin/feed-curate",
      "bin/feed-doctor",
      "bin/feed-mcp",
      "bin/feed-setup-ffmpeg",
      "bin/feed-setup-sandbox",
      "bin/feed-render",
      "lib/*-cli.ts",
      "tests/**/*.{js,mts}"
    ],
    "project": [
      "bin/*",
      "lib/**/*.ts",
      "sources/**/*.ts",
      "tests/**/*.{js,mts}"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [
      "agent-browser",
      "lefthook"
    ],
    "ignoreBinaries": [
      "uv"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "24",
    "agent-browser": "^0.26.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "knip": "^6.9.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "slop-scan": "github:modem-dev/slop-scan#v0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.9",
      "axios": ">=1.12.0",
      "follow-redirects": ">=1.15.6",
      "fast-uri": ">=3.1.2",
      "brace-expansion": ">=5.0.6"
    }
  }
}
