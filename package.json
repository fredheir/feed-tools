{
  "name": "@markolo/feed-tools",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "pnpm run typecheck && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "doctor": "./bin/feed-doctor",
    "setup:sandbox": "./bin/feed-setup-sandbox",
    "deadcode": "knip",
    "slop:scan": "slop-scan scan .",
    "slop:lint": "slop-scan scan . --lint",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test && pnpm run deadcode",
    "setup:yt-dlp": "uv tool install --force 'yt-dlp[default,curl-cffi]'"
  },
  "knip": {
    "entry": [
      "bin/feed-capture",
      "bin/feed-capture-cic",
      "bin/feed-classify",
      "bin/feed-curate",
      "bin/feed-doctor",
      "bin/feed-setup-sandbox",
      "bin/feed-render",
      "lib/*-cli.ts",
      "tests/**/*.{js,mts}"
    ],
    "project": [
      "bin/*",
      "lib/**/*.ts",
      "sources/**/*.ts",
      "tests/**/*.{js,mts}"
    ],
    "ignoreExportsUsedInFile": true,
    "ignoreDependencies": [
      "agent-browser",
      "lefthook"
    ],
    "ignoreBinaries": [
      "uv"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "agent-browser": "^0.23.4",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "knip": "^6.1.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.6.2",
    "slop-scan": "github:modem-dev/slop-scan#v0.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "vite": "^8.0.9",
      "axios": ">=1.12.0",
      "follow-redirects": ">=1.15.6"
    }
  }
}
