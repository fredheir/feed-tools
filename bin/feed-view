#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -lt 1 ]]; then
  cat <<'EOF'
Usage: feed-view <source> [limit] [--assets-dir DIR] [--save-dir DIR] [--ids x:...,x:...]
EOF
  exit 0
fi

source_name="$1"
shift

ids=""
capture_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ids)
      ids="${2:-}"
      shift 2
      ;;
    *)
      capture_args+=("$1")
      shift
      ;;
  esac
done

tmp_json="/tmp/feed-view-${source_name}.json"
tmp_html="/tmp/feed-view-${source_name}.html"

save_dir=""
remaining_export_args=()
for ((i=0; i<${#capture_args[@]}; i++)); do
  arg="${capture_args[$i]}"
  if [[ "$arg" == "--save-dir" ]]; then
    save_dir="${capture_args[$((i + 1))]:-}"
    remaining_export_args+=("$arg" "$save_dir")
    ((i++))
    continue
  fi
done

"$ROOT_DIR/bin/feed-capture" "$source_name" "${capture_args[@]}" > /dev/null
"$ROOT_DIR/bin/feed-export" "$tmp_json" --source "$source_name" "${remaining_export_args[@]}"
if [[ -n "$ids" ]]; then
  "$ROOT_DIR/bin/feed-render" "$tmp_json" --ids "$ids" "$tmp_html"
else
  "$ROOT_DIR/bin/feed-render" "$tmp_json" "$tmp_html"
fi
"$ROOT_DIR/bin/feed-open" "$tmp_html"
