{
  "repoType": ["node"],
  "packageManager": "pnpm",
  "requiresGeneratedCheck": false,
  "selfHostedRunnerLabels": [
    "self-hosted",
    "linux",
    "x64",
    "markolo-hetzner",
    "ci-light"
  ],
  "requiredFiles": [
    "AGENTS.md",
    "justfile",
    "lefthook.yml",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".repo-standards-ref",
    ".env.example",
    ".github/workflows/actions-hygiene.yml",
    ".github/workflows/contract.yml",
    ".github/workflows/dependency.yml",
    ".github/workflows/format.yml",
    ".github/workflows/secrets.yml",
    ".github/workflows/typecheck.yml",
    ".github/actionlint.yaml"
  ],
  "requiredSymlinks": [
    {
      "path": "CLAUDE.md",
      "target": "AGENTS.md"
    }
  ],
  "requiredWorkflows": [
    "actions-hygiene.yml",
    "contract.yml",
    "dependency.yml",
    "format.yml",
    "secrets.yml",
    "typecheck.yml"
  ],
  "requiredJustRecipes": [
    "fmt",
    "fix-all",
    "fix-worktree",
    "fmt-check",
    "lint",
    "actions-hygiene",
    "typecheck",
    "test",
    "test-fast",
    "test-one",
    "secrets",
    "secrets-staged",
    "deps-check",
    "deps-check-fast",
    "doctor",
    "doctor-staged",
    "sync",
    "sync-if-needed",
    "check-paths",
    "check-worktree",
    "check"
  ],
  "managedScripts": ["scripts/ci/just", "scripts/guards/_repo-standards"],
  "allowBarePythonIn": [],
  "suppressionBudget": {
    "total": 0
  },
  "hooks": {
    "lefthookCommand": "lefthook"
  },
  "requiredExecutableFiles": [
    "scripts/ci/just",
    "scripts/dev/check-paths",
    "scripts/dev/check-worktree",
    "scripts/dev/fix-all",
    "scripts/dev/fix-worktree",
    "scripts/dev/test-one",
    "scripts/dev/worktree-paths"
  ]
}
