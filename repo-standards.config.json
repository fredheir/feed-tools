{
  "repoType": ["node"],
  "packageManager": "pnpm",
  "nodeMajor": 24,
  "requiresGeneratedCheck": false,
  "selfHostedRunnerLabels": ["self-hosted", "linux", "x64", "markolo-hetzner"],
  "requiredFiles": [
    "AGENTS.md",
    "justfile",
    "lefthook.yml",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".env.example",
    ".github/workflows/actions-hygiene.yml",
    ".github/workflows/contract.yml",
    ".github/workflows/dependency.yml",
    ".github/workflows/format.yml",
    ".github/workflows/secrets.yml",
    ".github/workflows/typecheck.yml",
    ".github/actionlint.yaml"
  ],
  "requiredSymlinks": [
    {
      "path": "CLAUDE.md",
      "target": "AGENTS.md"
    }
  ],
  "requiredWorkflows": [
    "actions-hygiene.yml",
    "contract.yml",
    "dependency.yml",
    "format.yml",
    "secrets.yml",
    "typecheck.yml"
  ],
  "requiredJustRecipes": [
    "fmt",
    "fix",
    "fmt-check",
    "lint",
    "actions-hygiene",
    "typecheck",
    "test",
    "test-fast",
    "secrets",
    "secrets-staged",
    "deps-check",
    "deps-check-fast",
    "doctor",
    "doctor-staged",
    "sync",
    "sync-if-needed",
    "check-changed",
    "check"
  ],
  "allowBarePythonIn": [],
  "suppressionBudget": {
    "total": 0
  }
}
